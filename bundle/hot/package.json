{
  "name": "dsh-harness-hot-bundle",
  "description": "The Harness-owned hot mount/upgrade bundle: a loopback-pinned RPC surface (`/harness-hot`) that mounts, unmounts, and hot-upgrades an installed plugin's loader rows into the running composition without a restart. Pure host package — the bundle's substance is `cordis.patch.yml` (declared by `dsh.bundle.patch`) plus the `harnessHot` service and its `/harness-hot` channel.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./hot": {
      "types": "./lib/types/hot.d.ts",
      "default": "./lib/hot.js"
    },
    "./patch": {
      "types": "./lib/types/patch.d.ts",
      "default": "./lib/patch.js"
    },
    "./wire": {
      "types": "./lib/types/wire/index.d.ts",
      "default": "./lib/types/wire/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/hot.js",
    "lib/patch.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1-rc.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.6-rc.4",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1-rc.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.6-rc.4",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2-rc.4",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0",
    "zod": "^4.4.3"
  }
}
