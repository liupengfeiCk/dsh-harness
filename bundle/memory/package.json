{
  "name": "dsh-harness-memory-bundle",
  "description": "The Harness-owned memory bundle: the task-entity registry (T13, design §7 F10), the session-internal hierarchical compaction subsystem (T8), and the TencentDB memory engine adaptation (vendor MemoryCore) with its host adapter + LLM runner. Pure host package — the bundle's substance is `cordis.patch.yml` (declared by `dsh.bundle.patch`) plus the `tasks` host service, its `/memory-task` wire + `create_task` tool, and (T3) the `memory` engine host row.",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tasks": {
      "types": "./lib/types/tasks/index.d.ts",
      "default": "./lib/types/tasks/index.js"
    },
    "./tasks/wire": {
      "types": "./lib/types/tasks/wire/index.d.ts",
      "default": "./lib/types/tasks/wire/index.js"
    },
    "./tasks/tool": {
      "types": "./lib/types/tasks/tool.d.ts",
      "default": "./lib/types/tasks/tool.js"
    },
    "./compaction": {
      "types": "./lib/types/compaction/index.d.ts",
      "default": "./lib/types/compaction/index.js"
    },
    "./home-path": {
      "types": "./lib/types/home-path.d.ts",
      "default": "./lib/types/home-path.js"
    },
    "./adapters/*": {
      "types": "./lib/types/adapters/*.d.ts",
      "default": "./lib/types/adapters/*.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1-rc.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1-rc.4",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-apiproxy": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1-rc.4",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  }
}
