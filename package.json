{
  "name": "dsh-harness-subagent-bundle",
  "description": "The Harness-owned subagent bundle: an installable patch layer that replaces the official in-process subagent delegation with the Harness engine (service/spawn/fork), mounts the user-defined subagent registry, and adds the settings surface row. Self-contained: the in-process engine, the preset registry, the preset-edit mechanism, and the browser settings surface all ship inside this single package.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./in-process/service": {
      "types": "./lib/types/in-process/service.d.ts",
      "default": "./lib/types/in-process/service.js"
    },
    "./in-process/spawn": {
      "types": "./lib/types/in-process/spawn.d.ts",
      "default": "./lib/types/in-process/spawn.js"
    },
    "./in-process/fork": {
      "types": "./lib/types/in-process/fork.d.ts",
      "default": "./lib/types/in-process/fork.js"
    },
    "./in-process/tool": {
      "types": "./lib/types/in-process/tool.d.ts",
      "default": "./lib/types/in-process/tool.js"
    },
    "./preset": {
      "types": "./lib/types/preset/index.d.ts",
      "default": "./lib/types/preset/index.js"
    },
    "./preset-edit": {
      "types": "./lib/types/preset-edit/index.d.ts",
      "default": "./lib/types/preset-edit/index.js"
    },
    "./ui/client": {
      "types": "./lib/types/ui/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "factory/**"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-projection": "0.1.0-rc.6",
