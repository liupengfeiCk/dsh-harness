{
  // Solution file: the whole-harness graph for `tsc -b tsconfig.json` and the
  // tsserver entry. `extends` carries the base paths for get-tsconfig
  // consumers — tsx / vitest (no nearer tsconfig) resolves workspace imports
  // through this file. `files: []` keeps it program-less, so the host/client
  // cordis Context merges never meet.
  // NEVER add include/files entries, and NEVER flatten this solution into a
  // single ts.Program.
  "extends": "./tsconfig.base.json",
  "files": [],
  "references": [
    { "path": "./tsconfig.host.json" },
    { "path": "./tsconfig.client.json" }
  ]
}
