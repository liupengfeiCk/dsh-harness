  // sides merge cordis Context under the same keys with different services.
  "extends": "./tsconfig.base.client.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    "types": ["node"]
  },
  "files": [],
  "references": [
    { "path": "./bundle/subagent/tsconfig.client.json" },
    { "path": "./bundle/agent-preset-editing/tsconfig.client.json" },
    { "path": "./bundle/model-plan/tsconfig.client.json" }
  ]
}
