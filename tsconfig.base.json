{
  // Harness-owned package tier base config. Standalone: the @deepseek-ai/dsh-*
  // and @deepseek-ai/cordis dependencies resolve from harness/node_modules
  // (overrides link them to the upstream repo checkout) rather than the repo's
  // source paths. The `paths` block below pins every upstream dependency to its
  // prebuilt lib/types declaration file, so `tsc` consumes the upstream
  // packages' emitted `.d.ts` instead of pulling their `src` into a harness
  // package's own program (which would trip that package's rootDir and re-typecheck
  // upstream/vendor sources). This mirrors the role upstream project references
  // play in the main repo, without building (or mutating) any upstream package.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
  }
}
